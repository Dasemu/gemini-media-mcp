{
  "name": "gemini-veo-mcp",
  "version": "1.1.0",
  "private": true,
  "description": "Remote Streamable HTTP MCP server for Google Gemini image and Veo video generation",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "MEDIA_DIR=/tmp/gemini-veo-mcp-tests-$$ node --import tsx --test test/unit.test.ts",
    "test:integration": "node --import tsx --test test/integration-real.test.ts",
    "test:integration:compose": "node --import tsx --test test/integration-compose-real.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@google/genai": "2.23.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "dotenv": "16.6.1",
    "express": "5.2.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.6",
    "tsx": "4.23.15",
    "typescript": "5.9.2"
  }
}
